# Slot Panic — configuración de Apache (slot.pnyk.es).
#
# No servir lo que es del repositorio y no del sitio: la documentación, el
# arnés y la configuración de git. Todo va dentro de <IfModule> porque un
# alojamiento compartido puede no tener el módulo, y un .htaccess que falla se
# lleva por delante el sitio entero con un 500. Es el de Orbit Panic, recortado.

<IfModule mod_authz_core.c>
	<FilesMatch "(?i)\.(md|markdown|mjs|log|ini|conf|sql|bak|sh|bat|ps1|ya?ml|toml|env)$">
		Require all denied
	</FilesMatch>

	<FilesMatch "(?i)^(\.htaccess|\.gitignore|pnyk\.json)$">
		Require all denied
	</FilesMatch>

</IfModule>

<IfModule !mod_authz_core.c>
	<FilesMatch "(?i)\.(md|markdown|mjs|log|ini|conf|sql|bak|sh|bat|ps1|ya?ml|toml|env)$">
		Order allow,deny
		Deny from all
	</FilesMatch>

	<FilesMatch "(?i)^(\.htaccess|\.gitignore|pnyk\.json)$">
		Order allow,deny
		Deny from all
	</FilesMatch>

</IfModule>

# Los módulos ES tienen que servirse como JavaScript, y sin esto Apache sirve
# el manifest de la PWA como texto plano y Chrome lo ignora.
<IfModule mod_mime.c>
	AddType text/javascript .js
	AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule "(^|/)\." - [F,L]
	# Herramientas de mantenimiento (generador de páginas e iconos): no se sirven.
	RewriteRule ^tools/ - [F,L]
	# La envoltura de la app de las tiendas (APP.md §4). El push de master
	# publica todo el repositorio, /app incluido, y no debe servirse: se
	# contesta como si no estuviera.
	RewriteRule ^app(/|$) - [R=404,L]
</IfModule>

# Revalidar siempre el HTML, el JavaScript y el CSS (con el ETag: un 304 si no
# ha cambiado). Sin cabecera, el navegador cachea a ojo y, tras publicar,
# podía mezclar un módulo nuevo con otro viejo: un import que no existe y el
# juego no arranca. Los módulos ES no llevan ?v=, así que es la única defensa.
<IfModule mod_headers.c>
	<FilesMatch "(?i)\.(html|js|css)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	# El manifest va sin ?v= (su dirección identifica la PWA instalada) y el
	# service worker también: el navegador lo compara byte a byte para saber si
	# hay versión nueva. Los dos revalidan siempre.
	<FilesMatch "(?i)^(manifest\.webmanifest|service-worker\.js)$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
</IfModule>
